# Supabase PostgreSQL connection
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>
PGSSLMODE=require

SECRET_KEY=<long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEBUG=False
GOOGLE_CLIENT_ID=<google-client-id>
BACKEND_PUBLIC_BASE_URL=https://<render-service>.onrender.com
BACKEND_CORS_ORIGINS=https://<vercel-project>.vercel.app

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
CLOUDINARY_FOLDER=pickleball

# Optional email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-app-password>
SMTP_FROM_EMAIL=<from-email>
SMTP_FROM_NAME=Pickleball NP SPORTCLUB
SMTP_USE_TLS=true

# Preferred email provider on Render
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
